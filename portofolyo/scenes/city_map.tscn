[sub_resource type="Shader" id="sea_shader"]
code = "shader_type spatial;\nuniform vec3 deep = vec3(0.04, 0.26, 0.55);\nuniform vec3 shallow = vec3(0.1, 0.48, 0.75);\nvarying float wave;\nvoid vertex() {\n	wave = sin(VERTEX.x * 0.45 + TIME * 1.1) * 0.5 + cos(VERTEX.z * 0.38 + TIME * 0.8) * 0.5;\n	VERTEX.y += wave * 0.025;\n}\nvoid fragment() {\n	ALBEDO = mix(deep, shallow, 0.45 + wave * 0.15);\n	ROUGHNESS = 0.55;\n	SPECULAR = 0.25;\n}"

